  "narrative": {
    "northStar": "A Personal Introduction Suspended in Space",
    "overview": "The landing and playable cockpit share monumental Unbounded titles, Space\nGrotesk text and actions, warm ivory on near-black, orange commands and thin\nrectangular frames. The accepted landing supplies the visual authority for\nthis shared system. Dungyov informs the outlined/solid lettering; Oakley\nAxiom Space informs media scale and native-scroll depth, not asset identity.\n\nThe glossy toy astronaut connects an original generated landing image with\nthe existing model in the vanilla Three.js cockpit. A natural photographic\navatar and services portrait share one edit of the owner’s real photograph.\nThe landing is spacious and direct; the cockpit is playful and\ninstrument-dense. Flat controls, the shared avatar and equal EN/IT treatment\nconnect them while scrolling and gameplay retain their functional layouts.",
    "keyCharacteristics": [
      "Near-black space, warm ivory text and orange actions.",
      "Shared Unbounded display lettering and Space Grotesk prose and actions.",
      "Thin rectangular frames, flat controls and restrained two-pixel corners.",
      "A consistent toy astronaut character and recognizable photographic identity.",
      "Native-scroll depth on the landing; readable telemetry in the playable CV."
    ],
    "rules": [
      {
        "name": "The Shared Identity Rule",
        "body": "Use the same palette, display/body roles and\nflat control language across both routes; reserve signal colors for working\ninstruments and status.",
        "section": "colors"
      },
      {
        "name": "The Type Roles Rule",
        "body": "Use Unbounded for titles, Space Grotesk for reading\nand actions, and JetBrains Mono for telemetry and code on either surface.",
        "section": "typography"
      },
      {
        "name": "The Flat Controls Rule",
        "body": "Use fill, hairline borders and clear state\nchanges for interface depth; keep physical light in the space scene.",
        "section": "elevation & depth"
      },
      {
        "name": "The Optional Motion Rule",
        "body": "Readable content and usable navigation are\nthe base layer; depth travel enhances them without intercepting scrolling.",
        "section": "elevation & depth"
      }
    ],
    "dos": [
      "Do share Unbounded titles, Space Grotesk reading/actions and JetBrains Mono telemetry/code across landing and cockpit.",
      "Do use thin frames, flat controls, small control corners and clear outline/solid display contrast across both routes.",
      "Do preserve keyboard focus, native anchors, readable content and reduced-motion behavior in both languages.",
      "Do preserve the toy character across the existing cockpit model and original generated landing artwork, with recorded provenance.",
      "Do use the matching natural avatar and services portrait derived from the owner’s photograph, alongside actual shipped product imagery."
    ],
    "donts": [
      "Don't restore the orbit brand symbol, service-row icons or raw GLB renders as landing artwork.",
      "Don't restore the separate Orbitron/Rajdhani font system or decorative cockpit glow, scanlines and metal fasteners.",
      "Don't turn HUD signal colors into general marketing accents or monospace telemetry styles into body and action typography.",
      "Don't make reading or contact depend on animation, JavaScript or completing the cockpit.",
      "Don't represent the disabled booking controls as working until the owner's exact destination is supplied and verified."
    ]
  }
}
