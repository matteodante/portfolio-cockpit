# ============================================
# portfolio-v4 · Matteo Dante cockpit
# ============================================
# Copy: cp .env.example .env.local
# ============================================

# Canonical origin is https://matteodante.it (lib/constants/site.ts),
# including local previews. No environment override is needed.

# Optional Google measurement. Leave empty for local/preview environments.
# Production values live in Railway's variables (see docs/railway.md).
# GA4 loads only after analytics consent; no Google Ads tags are enabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Search Console HTML verification token (alternative to DNS verification).
GOOGLE_SITE_VERIFICATION=""

# ============================================
# OPENAI · Required for COMM chat module
# ============================================
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Optional PostHog (EU) project key: analytics after consent, through /ingest.
NEXT_PUBLIC_POSTHOG_KEY=""

# ============================================
# UPSTASH REDIS · Optional — cross-instance rate limiting for /api/chat.
# When unset, the route falls back to per-instance in-memory rate limiting
# (one Railway instance, so this is enough).
# ============================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# CV ACCESS · Gate the full CV / chat profile / private translations
# behind a shared access code. Required.
# /llms.txt is NOT gated: it is force-static and serves only
# LLMS_PUBLIC from lib/seo/llms-content.ts — no cookie, no blob.
# - CV_ACCESS_PASSWORD: the access code shared with recruiters
# - CV_ACCESS_SECRET:   long random string used to HMAC-sign the
#   access cookie. Generate: openssl rand -base64 64
# - CV_DECRYPT_KEY:     32-byte AES-256-GCM key (base64) used to
#   decrypt the 7 .enc blobs committed to the repo: CV md + pdf per
#   locale, private translations per locale, chat profile — the list
#   lives in scripts/encrypt-private.ts.
#   Generate: openssl rand -base64 32
# ============================================
CV_ACCESS_PASSWORD=""
CV_ACCESS_SECRET=""
CV_DECRYPT_KEY=""

# ============================================
# COURSES · Postgres, Google sign-in and the recordings bucket.
# All optional locally: without DATABASE_URL the courses page renders and
# the application form says it is not active yet.
# ============================================
# Local: postgres://postgres@localhost:5432/courses, then `bun run db:migrate`.
DATABASE_URL=""
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public origin the browser sees (local: http://localhost:3000).
BETTER_AUTH_URL=""
# Google OAuth client (redirect URI: <origin>/api/auth/callback/google).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated Google addresses that manage courses (/it/account/admin).
ADMIN_EMAILS=""
# Local only: "1" enables email/password sign-in for testing without Google.
COURSES_DEV_PASSWORD=""
# S3-compatible bucket for lesson recordings (Railway bucket references).
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
